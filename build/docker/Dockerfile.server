# 服务器版镜像: 多阶段构建, 产物是纯 Go 静态二进制 (distroless/static 基础镜像)。
#
# 由 `task build:docker` 调用, 前端已在本机构建好 (frontend/dist 由 main.go 的
# go:embed 打进二进制), 容器里只编 Go。
#
# 需要 CGO 时: docker build --build-arg CGO_ENABLED=1 \
#   --build-arg GO_IMAGE=golang:bookworm \
#   --build-arg RUNTIME_IMAGE=gcr.io/distroless/base-debian12 \
#   -f build/docker/Dockerfile.server .

ARG GO_IMAGE=golang:alpine
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12
ARG CGO_ENABLED=0

# ---- 构建阶段 ----
FROM ${GO_IMAGE} AS builder
ARG CGO_ENABLED

WORKDIR /app

# git 用于拉取依赖; 只有 CGO 场景才装 C 编译器。
RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git $([ "$CGO_ENABLED" = "1" ] && echo gcc musl-dev); \
    else \
        apt-get update && apt-get install -y --no-install-recommends git $([ "$CGO_ENABLED" = "1" ] && echo gcc libc6-dev) && rm -rf /var/lib/apt/lists/*; \
    fi

COPY . .

# 注意: 不要在这里对 go.mod 做 `sed '/^replace/d'` 之类的清理。本项目必须保留
#   replace github.com/only9464/ddddocr-go => github.com/only9464/ddddocr v0.0.1
# (上游 go.mod 声明的 module 路径与仓库地址不一致), 删掉会导致编译失败。
RUN go mod download

RUN CGO_ENABLED=${CGO_ENABLED} go build -tags server,production -trimpath -buildvcs=false -ldflags="-s -w" -o server .

# ---- 运行阶段 ----
FROM ${RUNTIME_IMAGE}

COPY --from=builder /app/server /server

EXPOSE 8080

# 容器内必须监听 0.0.0.0; 可在运行时用 -e WAILS_SERVER_HOST=... 覆盖。
ENV WAILS_SERVER_HOST=0.0.0.0

ENTRYPOINT ["/server"]
